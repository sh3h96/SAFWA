# SAFWA Backend Environment Configuration Example
# Copy this file to .env and adjust configuration for your environment.

# Node Environment & Server Port
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:3000,http://localhost:5173

# Authentication (Mandatory in production)
JWT_SECRET=your_jwt_secret_key_here

# Database Configuration (Mandatory in production)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=safwa_db
DB_USER=root
DB_PASSWORD=

# Email / SMTP Configuration (Optional in development, required for email features in production)
SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password
MAILTRAP_HOST=sandbox.smtp.mailtrap.io
MAILTRAP_PORT=2525
MAILTRAP_USER=your_mailtrap_username
MAILTRAP_PASS=your_mailtrap_password
